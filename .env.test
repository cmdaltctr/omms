# Loaded by `bun test` at startup. Unlike values set in tests/preload.ts, these
# also reach the child processes that tests spawn without an explicit `env`.

# Tests load the developer's real global config, which may turn on
# captureTrace. Keep the log, and the traces directory beside it, out of ~/.omms.
# scripts/run-tests-isolated.sh sets a separate directory for each full run;
# this fixed path is the fallback for single-file runs.
OMMS_LOG_FILE=/tmp/omms-test-logs/omms.log

# Keep the one-time migrations away from the developer's real store. See
# tests/preload.ts.
OMMS_SKIP_LEGACY_MIGRATION=1
OMMS_SKIP_TAG_PREFIX_MIGRATION=1
