{
  "name": "om-memory-system",
  "version": "3.0.0",
  "description": "Opinionated modular memory system for coding agents (OpenCode + Pi)",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "bin": {
    "om-memory-system": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./v2": {
      "types": "./dist/v2/plugin.d.ts",
      "import": "./dist/v2/plugin.js",
      "default": "./dist/v2/plugin.js"
    },
    "./tags": {
      "types": "./dist/services/tags.d.ts",
      "import": "./dist/services/tags.js",
      "default": "./dist/services/tags.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc && chmod +x dist/cli/index.js && bun run web:build",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "ci:local": "bash scripts/local-ci.sh",
    "verify:package": "node scripts/verify-package.mjs",
    "check:package": "bun run verify:package && publint && attw --pack --profile esm-only",
    "prepare": "husky",
    "prepublishOnly": "bun run verify:package"
  },
  "keywords": [
    "omms",
    "opencode",
    "pi",
    "memory",
    "vector-database",
    "ai",
    "coding-agent",
    "local",
    "standalone",
    "pi-package"
  ],
  "author": "cmdaltctr (https://github.com/cmdaltctr)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdaltctr/omms.git"
  },
  "homepage": "https://github.com/cmdaltctr/omms#readme",
  "bugs": {
    "url": "https://github.com/cmdaltctr/omms/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@libsql/client": "^0.17.4",
    "@opencode-ai/plugin": "^1.18.15",
    "@opencode-ai/sdk": "^1.18.15",
    "franc-min": "^6.2.0",
    "hono": "^4.12.32",
    "iso-639-3": "^3.0.1",
    "onnxruntime-node": "1.20.1",
    "zod": "^4.4.3"
  },
  "//": "Pin onnxruntime-node@1.20.1 (direct + override): nested OpenCode installs ignore package overrides (#184); 1.21.0–1.23.2 can SIGILL on macOS process exit (#225); fixed releases still lack darwin/x64 (microsoft/onnxruntime#27961).",
  "overrides": {
    "onnxruntime-node": "1.20.1",
    "bun-types": "1.3.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@eslint/js": "^10.0.1",
    "@opencode/plugin": "^2.0.16",
    "@types/bun": "^1.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "chat.params",
      "event"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/adapters/pi/extension.js"
    ]
  },
  "files": [
    "dist",
    "package.json"
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
