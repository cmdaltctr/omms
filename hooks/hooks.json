{
  "description": "OMMS memory: add the memories that match each prompt and subagent task, restore them after compaction, capture each finished turn",
  "modules": ["./omms.jsx"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/omms-launch.mjs\" --at-least-own-version claude-hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/omms-launch.mjs\" --at-least-own-version claude-hook user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/omms-launch.mjs\" --at-least-own-version claude-hook subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/omms-launch.mjs\" --at-least-own-version claude-hook stop",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
