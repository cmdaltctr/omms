{
  "description": "OMMS memory: inject memories at session start and per prompt, capture each finished turn",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "om-memory-system claude-hook session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "om-memory-system claude-hook user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "om-memory-system claude-hook stop",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
